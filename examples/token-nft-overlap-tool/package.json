{
  "name": "token-nft-overlap-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev:vercel": "npx vercel dev",
    "deploy:vercel": "npx vercel deploy --prod",
    "dev:cf": "npx wrangler dev",
    "deploy:cf": "npx wrangler deploy",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "export-manifest": "tsx scripts/export-manifest.ts",
    "validate": "pnpm run export-manifest && tool-sdk validate ./manifest.json",
    "hash": "pnpm run export-manifest && tool-sdk hash ./manifest.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensea/tool-sdk": "^0.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "tsx": "4.19.2",
    "typescript": "6.0.2",
    "viem": "2.31.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
