# Copy to .env.local and fill in. Loaded by `vercel dev` and by
# scripts/export-manifest.ts. Never committed.

# OpenSea v2 REST API key (https://docs.opensea.io/reference/api-keys)
OPENSEA_API_KEY=

# Direct Anthropic key for the personality LLM call.
ANTHROPIC_API_KEY=

# Optional model override
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Creator address recorded as the manifest's `creatorAddress`. Per ERC-8257,
# this MUST match the wallet that registers the tool on the ToolRegistry.
# Decoupled from RECIPIENT_ADDRESS so a hot deploy wallet can register
# while a cold wallet collects payouts.
CREATOR_ADDRESS=

# Recipient for the public-tier x402 paywall on Base mainnet (your payout
# wallet). Reachable even for local dev because src/manifest.ts reads it at
# import time.
RECIPIENT_ADDRESS=

# Subscription NFT contract on Base. Holders of an active subscription pass
# the predicate gate on /api/subscriber for free.
SUBSCRIPTION_COLLECTION=

# Minimum subscription tier required by the SubscriptionPredicate. `0`
# means "any active subscription, no tier requirement".
# SUBSCRIPTION_MIN_TIER=0

# Override for the manifest's endpoint field. Defaults to the production
# Vercel URL; set this once you know the real deployed URL.
# TOOL_ENDPOINT=https://wallet-personality-tool.vercel.app

# On-chain ToolRegistry tool ID for the subscriber route (decimal string).
# Required by `predicateGate` in api/subscriber.ts. The subscriber MANIFEST
# URL (/.well-known/ai-tool/wallet-personality-subscriber.json) is served
# without it, so the URL is reachable for `tool-sdk register` before the
# tool exists on chain. Obtain from the `ToolRegistered` event after
# registering with --access-predicate <SubscriptionPredicate address>.
SUBSCRIBER_TOOL_ID=

# Optional Base RPC override for predicate static-calls. Defaults to viem's
# public RPC.
# BASE_RPC_URL=
