# Copy to .env.local and fill in. Loaded by scripts/smoke-test-*.ts and by
# `vercel dev`. Never committed.

# OpenSea v2 REST API key (https://docs.opensea.io/reference/api-keys)
OPENSEA_API_KEY=

# Pick ONE of these two for LLM access:
#   ANTHROPIC_API_KEY  — direct to Anthropic (simplest for local)
#   AI_GATEWAY_API_KEY — routes through Vercel AI Gateway (used in production)
ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=

# Optional model override
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Creator address recorded as the manifest's `creatorAddress`.
# Per ERC-8257, this MUST match the wallet that registers the tool on the
# ToolRegistry contract. Decoupled from RECIPIENT_ADDRESS so a hot deploy
# wallet can register while a cold wallet collects payouts.
CREATOR_ADDRESS=

# Recipient for x402 paywall (your payout wallet on Base mainnet).
# Required even for local Level 2 tests because src/manifest.ts reads it at
# import time, and src/handler.ts asserts it's a real address. The Level 2
# script bypasses the handler so any valid 0x address works for local-only.
RECIPIENT_ADDRESS=

# Optional override for the manifest's endpoint field. Defaults to the
# guessed Vercel URL; only set this once you know the real deployed URL.
# TOOL_ENDPOINT=https://nft-appraisal-tool.vercel.app

# On-chain ToolRegistry tool ID for the holder tier (decimal string).
# Required by `predicateGate` in api/holder.ts (the /api/holder route).
# The holder MANIFEST URL (/.well-known/ai-tool/nft-appraiser-chonks.json)
# is served without it, so the URL is reachable for `tool-sdk register`
# before the tool exists on chain. Obtain from the `ToolRegistered` event
# after registering the holder tool with the ERC-721 owner predicate
# pointing at the CHONK collection (0x07152bfde079b5319e5308c43fb1dbc9c76cb4f9)
# on Base.
HOLDER_TOOL_ID=

# Optional Base RPC override for predicate static-calls. Defaults to viem's
# public RPC.
# BASE_RPC_URL=
